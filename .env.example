# AI API key for E2E test proxy.
# Copy this file to .env and set your key, then source it before running tests:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   make test-e2e
#
# In CI this is set via the NEST_AI_API_KEY repository secret.
# All other AI test-proxy defaults (endpoint, model) are configured
# automatically in tests/e2e/conftest.py.
NEST_AI_API_KEY=