# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments (never commit a .venv)
.venv/
venv/

# Raw documents excluded from version control (processed versions in _nest_context/)
raw_inbox/
_nest_sources/

# Nest project artifacts (if repo is accidentally initialized as Nest project)
.nest_manifest.json
.nest/
.github/agents/nest*.agent.md
_nest_context/

# Node.js / Sandbox
node_modules/

# OS metadata
.DS_Store

# Environment / secrets (see .env.example for required vars)
.env

# Nest error logs (generated during processing)
.nest_errors.log
DELETE/
# Nest - per-machine runtime artifacts
.nest/errors.log
